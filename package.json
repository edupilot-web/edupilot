{
  "name": "edupilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:colleges": "tsx --env-file=.env.local scripts/seed-colleges.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "seed:curriculum": "tsx --env-file=.env.local scripts/seed-curriculum.ts",
    "seed:textbooks": "tsx --env-file=.env.local scripts/seed-textbooks.ts",
    "seed:topics": "tsx --env-file=.env.local scripts/seed-topics.ts",
    "sync:role-permissions": "tsx --env-file=.env.local scripts/sync-role-permissions.ts",
    "ensure-indexes": "tsx --env-file=.env.local scripts/ensure-indexes.ts",
    "reminders": "tsx --env-file=.env.local scripts/send-reminders.ts",
    "migrate:profiles": "tsx --env-file=.env.local scripts/migrate-student-profiles.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env.local --test tests/integration/*.test.ts",
    "test:all": "npm run test && npm run test:integration",
    "reconcile:wallets": "tsx --env-file=.env.local scripts/reconcile-wallets.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.9",
    "mongoose": "^9.9.3",
    "next": "16.3.1",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
