# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=edupilot

# Index creation. Mongoose builds declared indexes on first use of a model,
# which is convenient in development and slow on a populated collection. It is
# therefore on outside production and off in it, where `npm run ensure-indexes`
# creates them once. Set to true/false only to override that default.
# MONGODB_AUTO_INDEX=

# Secret used to sign student session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Secret used to sign ADMIN session JWTs. Falls back to JWT_SECRET so a fresh
# clone works, but the two should differ in any real deployment: sharing one
# means a compromised student signing key is also an admin one.
ADMIN_JWT_SECRET=

# The public origin of this deployment. Used to build the links inside emails,
# which are opened later, elsewhere — so it cannot be derived from a request.
# Must NOT have a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in ("Continue with Google"). Create an OAuth 2.0 Web application
# client at https://console.cloud.google.com/apis/credentials and add the
# callback as an authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# Leave these unset to run without Google — the button then explains it is not
# configured instead of failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Which transport delivers mail: `brevo` or `console`. Leave unset to pick
# automatically — Brevo when it has a key, otherwise `console`, which logs the
# message and its link to the server output instead of sending it.
# `console` is refused in production.
EMAIL_TRANSPORT=

# Brevo (https://developers.brevo.com), the transactional email API.
# BREVO_API_KEY is an API v3 key — Brevo dashboard → SMTP & API → API keys →
# Generate a new key. It starts with `xkeysib-`.
BREVO_API_KEY=
# BREVO_TIMEOUT_MS=10000

# The From address on outgoing mail. It must be a sender Brevo has verified:
# either a validated single sender, or an address on an authenticated domain.
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=EduPilot

# How long a verification link stays valid, in minutes. Defaults to 60,
# capped at 1440.
# EMAIL_VERIFICATION_TTL_MINUTES=60

# ── AI course content ─────────────────────────────────────────────────────
# The AI provider key, read from the environment at call time and never stored
# in the database (see docs/TECHNICAL.md §6.9). Leave it unset and the module
# runs on its mock provider, which produces clearly-marked placeholder content
# that the publish endpoint refuses — so the whole flow is usable locally
# without a key, and nothing fake can reach a student.
#
# A provider must ALSO be enabled in Admin → AI & Learning → AI Settings.
# Setting the key alone does not start spending money.
GEMINI_API_KEY=

# ── Google Vertex AI (the primary provider) ───────────────────────────────
# The same Gemini models as GEMINI_API_KEY above, reached through Google Cloud.
# It is the primary because of how it is governed rather than what it returns:
# access is an IAM role that can be scoped, audited and rotated centrally
# instead of a key somebody pasted into an environment, prompts are covered by
# the Cloud terms and are not used to train the models, and quota belongs to the
# project rather than to one key. For a platform whose prompts carry a named
# student's syllabus and their questions, that is the distinction that matters.
#
# Required:
GOOGLE_VERTEX_PROJECT_ID=

# Region. "global" (the default) routes to wherever the model has capacity,
# which avoids the "model not available in this region" failure that makes a
# correct configuration look broken. Pin a region only for data residency.
# GOOGLE_VERTEX_LOCATION=global

# Credentials — pick ONE. Tried in this order.
#
# 1. Nothing at all, when running ON Google Cloud (Cloud Run, GCE, App Engine)
#    with a service account attached. Best where available: no key exists to
#    leak, rotate or commit. Grant it the "Vertex AI User" role.
#
# 2. A service account key, as JSON. The normal choice off Google Cloud.
#    Accepts raw JSON or base64 — use base64 on any platform that mangles
#    newlines in environment variables, which most of them do.
# GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
#
# 3. A token from `gcloud auth print-access-token`. Expires in an hour and
#    cannot refresh itself, so this is for a laptop, never a deployment.
# GOOGLE_VERTEX_ACCESS_TOKEN=

# ── AI tutor (student-facing) ─────────────────────────────────────────────
# The student tutor routes through the same provider abstraction as the admin
# module, but chooses its model per request rather than from a database
# document — a question at "Basic" and one at "Expert" should not cost the
# same. Leave all of this unset and the tutor answers with its mock provider,
# which writes clearly-marked placeholder text: the whole flow works locally
# with no key, and nothing fake can be mistaken for a real explanation.
#
# Provider names: vertex, gemini, deepseek, groq, openai, openai-compatible, mock.

# The everyday model. Handles Basic, Practical and Intermediate.
# Flash rather than Pro: explaining a syllabus topic to an undergraduate is
# what it is good at, and it costs roughly a tenth as much per answer. On a
# platform where every student may ask ten questions a day, that is the budget.
AI_DEFAULT_PROVIDER=vertex
AI_DEFAULT_MODEL=gemini-2.5-flash

# The better model, used only for Advanced and Expert — and dropped
# automatically once the monthly budget passes 80% (see AI_MONTHLY_BUDGET_USD).
AI_ADVANCED_PROVIDER=vertex
AI_ADVANCED_MODEL=gemini-2.5-pro

# Ordered fallback chain, comma-separated, tried when the tier above fails.
# A model may be pinned with a colon. Unknown names are ignored rather than
# breaking the tutor, so a typo here degrades instead of failing.
#
# Gemini by API key is the backup, for two reasons. It is the cheapest option
# that is not a different model — Flash runs well under the comparable OpenAI
# tier per million tokens — and because it IS the same model over the same wire
# format, a fallback answer has the same shape, obeys the same response schema
# and reads the same to a student. Falling from Gemini onto GPT would change
# how every answer is written at the exact moment something is already wrong.
#
# It also fails independently of the primary in the way that matters: an
# expired service account, a missing IAM role or a project quota takes Vertex
# down without touching an API key.
#
# Add a genuinely different vendor after it if you want cover for a Google-wide
# outage. DeepSeek is the cheap option, OpenAI the expensive one:
#   AI_FALLBACK_PROVIDERS=gemini,deepseek
AI_FALLBACK_PROVIDERS=gemini

# Provider credentials. Read from the environment at call time, never stored in
# the database and never returned by any API.
# GEMINI_API_KEY is shared with the admin course-content module above.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# For a self-hosted or proxied OpenAI-compatible endpoint. The base URL has no
# default: a wrong one would send prompts to somebody else's server.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Override a service's endpoint (regional, or through a gateway).
# DEEPSEEK_BASE_URL=
# GROQ_BASE_URL=
# OPENAI_BASE_URL=

# ── AI cost control ───────────────────────────────────────────────────────
# Questions a student may ask per day. Cached answers and failed requests do
# not count — a cached answer calls no provider, and a student whose questions
# all hit an outage has not used their day.
FREE_DAILY_AI_QUESTIONS=10
PREMIUM_DAILY_AI_QUESTIONS=50

# Estimated monthly spend ceiling, in whole US dollars. 0 (or unset) disables
# the check entirely. At 80% the tutor stops using the advanced model; at 100%
# it refuses new questions while still serving every stored and cached answer.
AI_MONTHLY_BUDGET_USD=0

# Cross-student answer caching. On unless explicitly disabled, because the
# default a deployment gets by doing nothing should be the cheap one. Only
# questions with no conversation history behind them are ever cached.
# AI_CACHE_ENABLED=true

# ── Payments (Razorpay) ─────────────────────────────────────────
# The campus wallet. Leave these unset and /wallet still works — the balance,
# the statement and every read path are real; only "Add money" is unavailable,
# and the screen says so rather than showing a button that fails on tap.
#
# THREE credentials, and they are NOT interchangeable.

# Public. This one reaches the browser, because Razorpay Checkout needs it to
# name the account. It authorises nothing on its own.
# Test keys start rzp_test_, live keys rzp_live_ — the app reads the mode from
# the prefix rather than from a separate flag, because a flag can disagree with
# the key and the direction it disagrees in is the expensive one.
RAZORPAY_KEY_ID=

# Secret. API authentication, and the signature on the browser's payment
# callback. Never sent to a client, never stored in the database.
RAZORPAY_KEY_SECRET=

# Secret, and a DIFFERENT secret. Razorpay generates this separately when you
# add a webhook; it is not the key secret. Using the key secret here is a common
# mistake and fails verification for every webhook, which looks like Razorpay
# being broken rather than like a configuration error.
#
# Without it the webhook endpoint returns 503 and refuses to act, because an
# unverified request that credits a wallet is an open door to free money.
RAZORPAY_WEBHOOK_SECRET=

# Point the webhook at:  https://<your-domain>/api/webhooks/razorpay
# Subscribe to:          payment.captured, payment.failed, order.paid,
#                        refund.processed, refund.failed
#
# The webhook is the AUTHORITATIVE settlement path. The browser callback only
# makes the balance move while the student is still looking at the screen; a
# student who pays and closes the tab is credited by the webhook and nothing
# else. A deployment without one will lose credits.

# ── Teachers, assignments and notes ───────────────────────────────────────
# Whether a teacher signup is approved on the spot.
#
# OFF by default, and deliberately so: approving every self-declared teacher
# would let anyone with an email address publish to a college's students, which
# is the one failure in this module with no undo. Turn it on only for a closed
# pilot where you control who can reach the signup form.
#
# Approval is only half the gate — a teacher also needs a confirmed email
# address before they can publish, and that is not configurable.
TEACHER_AUTO_APPROVE=false

# ── File storage ──────────────────────────────────────────────────────────
# Where uploaded attachments are written. `local` is the only implemented
# driver and is the default, so uploads work with no configuration.
#
# `local` writes to the server's own filesystem, which is right for a single
# server and wrong for anything horizontally scaled or serverless — there the
# disk is neither shared nor durable. Setting this to anything else fails
# loudly on the first upload rather than silently falling back, because a
# deployment writing student submissions onto an ephemeral container
# filesystem should find out immediately.
STORAGE_DRIVER=local

# Where the local driver puts files. Relative to the project root.
#
# Deliberately NOT inside `public/`: anything under `public/` is served with no
# authorisation at all, which would hand every student submission to anyone who
# could guess a filename. Downloads go through /api/files/:id, which checks the
# session on every request.
STORAGE_LOCAL_ROOT=.uploads
