# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=edupilot

# Index creation. Mongoose builds declared indexes on first use of a model,
# which is convenient in development and slow on a populated collection. It is
# therefore on outside production and off in it, where `npm run ensure-indexes`
# creates them once. Set to true/false only to override that default.
# MONGODB_AUTO_INDEX=

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# The public origin of this deployment. Used to build the links inside emails,
# which are opened later, elsewhere — so it cannot be derived from a request.
# Must NOT have a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in ("Continue with Google"). Create an OAuth 2.0 Web application
# client at https://console.cloud.google.com/apis/credentials and add the
# callback as an authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# Leave these unset to run without Google — the button then explains it is not
# configured instead of failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Which transport delivers mail: `postal` or `console`. Leave unset to pick
# automatically — Postal when it has credentials, otherwise `console`, which
# logs the message and its link to the server output instead of sending it.
# `console` is refused in production.
EMAIL_TRANSPORT=

# Postal (https://docs.postalserver.io), the self-hosted mail server.
# POSTAL_API_URL is the origin only, with no path: the client appends
# /api/v1/send/message. POSTAL_API_KEY is a *server* API key — Postal console →
# your mail server → Credentials → New credential → type "API".
POSTAL_API_URL=
POSTAL_API_KEY=
# POSTAL_TIMEOUT_MS=10000

# The From address on outgoing mail. Its domain must be one Postal is
# configured to send for, with SPF and DKIM published.
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=EduPilot

# How long a verification link stays valid, in minutes. Defaults to 60,
# capped at 1440.
# EMAIL_VERIFICATION_TTL_MINUTES=60
